rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── ユーティリティ ───
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ownerUid の friends に otherUid が登録されているか（フレンド関係の確認）
    function isFriendOf(ownerUid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(otherUid));
    }

    // 受信者 toUid の受信箱に書き込める、形式の正しい共有ステージか
    function isValidSharedStage(toUid) {
      return isAuth() &&
        request.auth.uid != toUid &&
        request.auth.uid == request.resource.data.fromUid &&
        isFriendOf(toUid, request.auth.uid) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 20 &&
        request.resource.data.rows is list &&
        request.resource.data.rows.size() == 5 &&
        request.resource.data.par is int &&
        request.resource.data.par >= 1 && request.resource.data.par <= 24;
    }

    // ─── users コレクション ───
    // 公開プロフィール（nickname / avatarEmoji / points のみ）。
    // フレンドをユーザーIDで検索できるよう、認証済みユーザーなら誰でも
    // 読み取り可能にする。書き込み（公開プロフィールの同期）は本人のみ。
    // メールアドレス等の個人情報はここには一切保存しない。
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);

      // フレンド一覧: 自分の一覧は自分だけが読める。
      // 承認時に「相手の friends に自分のエントリを書く」必要があるため、
      // 書き込みは「自分の friends に自分が書く」か「friendId が自分（＝相手が
      // 自分を追加する）」のいずれかを許可する。
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isAuth() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // 受信中フレンド申請: 自分宛の申請は自分だけが読める・削除できる
      // （承認・拒否）。書き込み（申請の送信）は申請先(userId)以外の
      // 認証済みユーザーが、ドキュメントID(=自分のuid)を自分のuidと
      // 一致させた場合のみ許可する（他人になりすました申請を防ぐ）。
      match /friendRequests/{fromUserId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuth() &&
          request.auth.uid == fromUserId &&
          request.auth.uid != userId;
        allow update: if false;
      }

      // ─── ともだちステージ（ロボットゲーム）───
      // 受信箱: 友だちが作ったステージが届く。読み取り・削除は受信者本人だけ。
      // 書き込みは「userId の friends に自分が入っている（＝フレンド）」送り主だけ。
      // 自由入力はステージ名（20文字以内）のみ。盤面は5行・par は1〜24に制限する。
      match /inbox/{stageId} {
        allow read, delete: if isOwner(userId);
        allow create: if isValidSharedStage(userId);
        allow update: if isValidSharedStage(userId) &&
          resource.data.fromUid == request.auth.uid;
      }

      // 遊んだ結果: ステージを作った人(userId)だけが読める。
      // 書き込みは、フレンドである遊んだ本人だけ（ドキュメントIDも本人のuidで固定）。
      match /stageResults/{resultId} {
        allow read: if isOwner(userId);
        allow create, update: if isAuth() &&
          request.auth.uid != userId &&
          request.auth.uid == request.resource.data.playerUid &&
          resultId == request.resource.data.stageId + '_' + request.auth.uid &&
          isFriendOf(userId, request.auth.uid) &&
          request.resource.data.stars is int &&
          request.resource.data.stars >= 1 && request.resource.data.stars <= 3 &&
          request.resource.data.blocks is int &&
          request.resource.data.blocks >= 1 && request.resource.data.blocks <= 24;
      }
    }

    // ─── その他のコレクションは拒否 ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
