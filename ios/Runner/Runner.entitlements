<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications Capability -->
	<!-- Required for: Firebase Cloud Messaging, Remote Notifications -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Background Modes -->
	<!-- Required for: Receiving remote notifications in background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Keychain Sharing -->
	<!-- Required for: Secure storage of Firebase auth tokens & credentials -->
	<!-- $(AppIdentifierPrefix) is automatically replaced by Xcode with the Team ID -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.schoolcode.programming</string>
	</array>

	<!-- iCloud Sync (Optional - for future learning progress sync) -->
	<!-- Uncomment if CloudKit integration is added later -->
	<!--
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.schoolcode.programming</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	-->
</dict>
</plist>
